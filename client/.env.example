# Frontend API target. Include /api, or the client will add it automatically.
VITE_API_URL=http://localhost:4000/api

# Values shown in the WhatsApp settings console for local provider setup.
VITE_WHATSAPP_WEBHOOK_URL=http://localhost:4000/webhooks/whatsapp
VITE_WHATSAPP_VERIFY_TOKEN=local-whatsapp-verify-token
