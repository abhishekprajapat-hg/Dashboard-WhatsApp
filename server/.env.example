# Runtime
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/whatscrm
DEMO_MODE=false

# Auth
# Production requires a real random value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars
JWT_EXPIRES_IN=15m

# Public URLs and browser access
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# WhatsApp webhooks and Meta Cloud API defaults
META_GRAPH_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=local-whatsapp-verify-token
# Embedded Signup (client connects their own WABA via a Facebook-hosted popup, no manual token
# entry) - appId is public/shipped to the client, embeddedSignupConfigId comes from App Dashboard ->
# Facebook Login for Business -> Configurations (no API to create it, manual one-time setup).
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_DISPLAY_NAME=Meta WhatsApp
WHATSAPP_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Encrypts stored WhatsApp account credentials. Production requires a real random value with at
# least 32 characters. Keep this independent from JWT_SECRET and never rotate them together -
# rotating this key alone will make existing stored credentials undecryptable, requiring
# reconnecting every WhatsApp account.
WHATSAPP_CREDENTIAL_SECRET=

# Public signup / social login for new clients
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=
# Separate from META_INSTAGRAM_REDIRECT_URI above (that one connects a client's own Instagram
# business account; this one is the "log into Dashboard-WhatsApp with Instagram" callback).
META_INSTAGRAM_LOGIN_REDIRECT_URI=
# Reuses META_APP_ID/WHATSAPP_APP_SECRET above - a separate OAuth product on the same Meta app.
META_FACEBOOK_LOGIN_REDIRECT_URI=
# Facebook Page connect (Settings -> Facebook) - also reuses META_APP_ID/WHATSAPP_APP_SECRET.
META_FACEBOOK_PAGES_REDIRECT_URI=
META_FACEBOOK_PAGES_VERIFY_TOKEN=
# Genuinely new - create a Google Cloud OAuth Client (console.cloud.google.com) before this works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Authentication-category WhatsApp template for signup OTP codes - must be created and approved in
# WhatsApp Manager first (a freeform text send can't reach a brand-new number with no open session).
WHATSAPP_OTP_TEMPLATE_NAME=signup_otp

# Ops-only: scripts/deploy-health-check.sh sends a WhatsApp alert here (via the same system
# account above) when the deploy pipeline drifts - stuck git pull, or the running process hasn't
# restarted since the last commit. Needs its own approved UTILITY-category template (same "no open
# 24h session" reason as the OTP one) - set both once that's approved. Not used by the main app.
DEPLOY_ALERT_PHONE=
DEPLOY_ALERT_TEMPLATE_NAME=deploy_health_alert

# Client billing (Razorpay Subscriptions) - one Nemnidhi-owned account bills every client.
# Plan ids are created once in Razorpay Dashboard (Subscriptions > Plans), not provisionable via API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC_ID=
RAZORPAY_PLAN_MEDIUM_ID=
RAZORPAY_PLAN_PRO_ID=

# Google Sheet lead sync via Apps Script web app
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=change-this-secret

# Optional AI assistant providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest
LOCAL_LLM_URL=http://localhost:11434/api/chat
LOCAL_LLM_MODEL=llama3.1

# Optional cache, queue, and event bus
REDIS_URL=
RABBITMQ_URL=

# Optional media storage. Use local uploads by default.
MEDIA_STORAGE_DRIVER=local
CDN_BASE_URL=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Optional telemetry and feature flags
OTEL_ENABLED=false
OTEL_SERVICE_NAME=whatscrm-api
FEATURE_INFRASTRUCTURE_PANEL=true
FEATURE_QUEUE_PROCESSING=true
FEATURE_S3_MEDIA_STORAGE=false
FEATURE_RABBITMQ_EVENTS=false
FEATURE_ZERO_DOWNTIME_MODE=true

# Optional production-to-local sync script inputs
PROD_MONGODB_URI=
LOCAL_MONGODB_URI=
ALLOW_PROD_TO_LOCAL_SYNC=no
