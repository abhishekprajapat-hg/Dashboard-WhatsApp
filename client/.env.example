# Frontend API target. Include /api, or the client will add it automatically.
VITE_API_URL=http://localhost:4000/api

# Values shown in the WhatsApp settings console for local provider setup.
VITE_WHATSAPP_WEBHOOK_URL=http://localhost:4000/webhooks/whatsapp
VITE_WHATSAPP_VERIFY_TOKEN=local-whatsapp-verify-token

# WhatsApp Embedded Signup. appId is public (safe to ship to the browser - it's the same
# Dashboard app, App ID 1622746365465041). configId comes from App Dashboard -> Facebook Login
# for Business -> Configurations - there's no API to create it, it's a one-time manual setup step.
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
