# Runtime
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/whatscrm
DEMO_MODE=false

# Auth
# Production requires a real random value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars
JWT_EXPIRES_IN=15m

# Public URLs and browser access
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# WhatsApp webhooks and Meta Cloud API defaults
META_GRAPH_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=local-whatsapp-verify-token
WHATSAPP_DISPLAY_NAME=Meta WhatsApp
WHATSAPP_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_CREDENTIAL_SECRET=

# Google Sheet lead sync via Apps Script web app
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=change-this-secret

# Optional AI assistant providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest
LOCAL_LLM_URL=http://localhost:11434/api/chat
LOCAL_LLM_MODEL=llama3.1

# Optional cache, queue, and event bus
REDIS_URL=
RABBITMQ_URL=

# Optional media storage. Use local uploads by default.
MEDIA_STORAGE_DRIVER=local
CDN_BASE_URL=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Optional telemetry and feature flags
OTEL_ENABLED=false
OTEL_SERVICE_NAME=whatscrm-api
FEATURE_INFRASTRUCTURE_PANEL=true
FEATURE_QUEUE_PROCESSING=true
FEATURE_S3_MEDIA_STORAGE=false
FEATURE_RABBITMQ_EVENTS=false
FEATURE_ZERO_DOWNTIME_MODE=true

# Optional production-to-local sync script inputs
PROD_MONGODB_URI=
LOCAL_MONGODB_URI=
ALLOW_PROD_TO_LOCAL_SYNC=no
